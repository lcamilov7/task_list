<div class="bg-white rounded-xl shadow-md p-4 mb-4 flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-start"
     data-controller="<%= STIMULUS_CONTROLLER %>">
  <div class="flex-1">
    <h2 class="text-lg font-semibold text-gray-800"><%= task.title %></h2>

    <button
      type="button"
      class="mt-2 cursor-pointer"
      data-action="click-><%= STIMULUS_CONTROLLER %>#toggleDescription" aria-expanded="false">
      <div data-<%= STIMULUS_CONTROLLER %>-target="chevron">
        <%= render Image::SvgComponent.new(
          icon: 'chevron',
          classes: 'text-gray-500  stroke-2'
        ) %>
      </div>
    </button>

    <div class="mt-1 text-gray-600 hidden break-words whitespace-normal" data-<%= STIMULUS_CONTROLLER %>-target="description">

      <%= task.description %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-2 mt-3 sm:mt-0 sm:ml-4">
    <%= link_to 'Edit', edit_task_path(task), class: "text-sm px-3 sm:py-1 py-3 bg-yellow-400 text-white rounded hover:bg-yellow-500 text-center", data: { turbo_stream: true } %>

    <%= link_to 'Remove', task_path(task), data: { turbo_method: :delete },
        class: "text-sm px-3 sm:py-1 py-3 bg-red-500 text-white rounded hover:bg-red-600 text-center" %>
    <% if task.done? %>

    <% else %>
      <%= form_with model: task, url: task_path(task), data: { turbo: true }, html: { method: :patch } do |f| %>
        <%= f.hidden_field(:status, { value: Task.statuses[:done] }) %>
        <%= f.submit 'Complete', class: "text-sm px-3 sm:py-1 py-3 bg-green-500 text-white rounded hover:bg-green-600 text-center cursor-pointer w-full" %>
      <% end %>
    <% end %> 
  </div>
</div>
