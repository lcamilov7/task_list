<div id="<%= dom_id(task) %>" class="relative bg-white rounded-xl shadow-md p-4 mb-4 flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-start"
     data-controller="<%= STIMULUS_CONTROLLER %>">
  <div class="flex">
    <div class="w-full">
      <div class="flex flex-col sm:mb-2">
        <span class="text-[12px] text-gray-500"><%= task.created_at.strftime("%m/%d/%Y %H:%M") %></span>
        <h2 class="text-lg font-semibold text-gray-800"><%= task.title %></h2>
      </div>

      <div class="flex flex-col sm:flex-row gap-2 mt-3 sm:mt-0 w-full">
        <%= link_to 'Remove', task_path(task), data: { turbo_method: :delete },
            class: "text-sm px-3 sm:py-1 py-3 bg-red-500 text-white rounded hover:bg-red-600 text-center" %>

        <% if task.done? %>
          <h2 class="text-[12px] text-gray-500 sm:py-1">Done at: <%= task.done_at.strftime("%m/%d/%Y %H:%M") %></h2>
        <% else %>
          <%= link_to 'Edit', edit_task_path(task), class: "text-sm px-3 sm:py-1 py-3 bg-yellow-400 text-white rounded hover:bg-yellow-500 text-center", data: { turbo_stream: true } %>
          <%= button_to 'Complete',
                        task_path(task),
                        method: :patch,
                        form: { data: { turbo_stream: true } },
                        params: { task: { done: true } },
                        class: "text-sm px-3 sm:py-1 py-3 bg-green-500 text-white rounded hover:bg-green-600 text-center cursor-pointer w-full" %>
        <% end %> 
      </div>
      <div class="mt-2 text-gray-600 hidden break-words whitespace-normal" data-<%= STIMULUS_CONTROLLER %>-target="description">
        <%= task.description %>
      </div>
    </div>
    <button
      type="button"
      class="mt-2 cursor-pointer absolute top-2 right-2"
      data-action="click-><%= STIMULUS_CONTROLLER %>#toggleDescription" aria-expanded="false">
      <div data-<%= STIMULUS_CONTROLLER %>-target="chevron">
        <%= render Image::SvgComponent.new(
          icon: 'chevron',
          classes: 'text-gray-500  stroke-2'
        ) %>
      </div>
    </button>
    <div class="absolute top-2 left-2 w-2 h-2 rounded-xl <%= task.done? ? 'bg-green-200' : 'bg-yellow-200'%>"></div>
  </div>
</div>
