<%= turbo_frame_tag :tasks_index do %>
  <div class="flex flex-col items-center justify-center min-h-screen">
    <div class="flex items-center my-4 gap-12">
      <h1 class="text-2xl font-bold">Task list</h1>
      <%= link_to '+', new_task_path, class: 'inline-flex justify-center py-1 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 cursor-pointer', data: { turbo_stream: true } %>
      <button type=""></button>
    </div>

    <div class="bg-white p-4 rounded-t-xl shadow-lg w-full max-w-md flex justify-between border-b border-gray-200">
      <%= link_to('done', tasks_path(params: { query: { done: true } }), data: { turbo_stream: true }, class: "text-blue-600 hover:underline") %>
      <%= link_to('pending', tasks_path(params: { query: { done: false } }), data: { turbo_stream: true }, class: "text-blue-600 hover:underline") %>
      <%= link_to('all', tasks_path, data: { turbo_stream: true }, class: "text-blue-600 hover:underline") %>
    </div>
    <div class="bg-gray-50 p-8 rounded-b-xl shadow-lg w-full max-w-md max-h-[70vh] min-h-[70vh] overflow-y-auto">
      <div id="tasks-card-list">
        <%= render(Tasks::ListComponent.new(tasks: @tasks)) %>
      </div>
    </div>
    <div id="task-drawer-container"></div>
  </div>
<% end %>
