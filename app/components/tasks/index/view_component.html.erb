<%= turbo_frame_tag :tasks_index do %>
  <div class="flex flex-col items-center justify-center min-h-screen mx-2">
    <%= image_tag('peny_logo.png', class: 'w-20') %>
    <div class="flex items-center justify-between w-full max-w-xl px-4 py-4 bg-white shadow-md rounded-xl mt-3 mb-4">
        <h1 class="text-2xl font-bold text-gray-800">Task list</h1>
      <div data-controller="<%= CLOCK_CONTROLLER %>" class="flex items-center">
        <div class="flex flex-col ml-3 items-end">
          <span data-<%= CLOCK_CONTROLLER %>-target="time" class="font-mono text-sm text-gray-700"></span>
          <span class="text-left text-sm text-gray-400">No redirect watch helper</span>
        </div>
      </div>
    </div>

    <div class="w-full max-w-xl flex items-center justify-center">
            <%= link_to '+',
                  new_task_path,
                  class: 'flex items-center text-4xl justify-center w-full text-white bg-blue-600 hover:bg-blue-700 rounded-xl py-2 shadow transition',
                  data: { turbo_stream: true } %>
    </div>
    <div class="bg-white rounded-t-xl shadow-lg w-full max-w-xl border-b border-gray-200 mt-4">
      <div class="grid grid-cols-3 text-center">
        <%= link_to 'DONE',
                    tasks_path(params: { query: { done: true } }),
                    data: { turbo_stream: true },
                    class: "#{done? == 'true' ? '!bg-blue-100 !text-gray-700' : ''} rounded-tl-xl block px-4 py-6 text-gray-400 hover:bg-gray-50 hover:text-gray-800 transition" %>

        <%= link_to 'PENDING',
                    tasks_path(params: { query: { done: false } }),
                    data: { turbo_stream: true },
                    class: "#{done? == 'false' ? '!bg-blue-100 !text-gray-700' : ''} block px-4 py-6 text-gray-400 hover:bg-gray-50 hover:text-gray-800 transition" %>

        <%= link_to 'ALL',
                    tasks_path,
                    data: { turbo_stream: true },
                    class: "#{'!bg-blue-100 !text-gray-700' unless done?} rounded-tr-xl block px-4 py-6 text-gray-400 hover:bg-gray-50 hover:text-gray-800 transition" %>
      </div>
    </div>

    <div class="bg-gray-50 p-8 rounded-b-xl shadow-lg w-full max-w-xl max-h-[55vh] min-h-[55vh] overflow-y-auto">
      <div id="tasks-card-list">
        <%= render(Tasks::ListComponent.new(tasks: @tasks)) %>
      </div>
    </div>
    <div id="task-drawer-container"></div>
  </div>
<% end %>
